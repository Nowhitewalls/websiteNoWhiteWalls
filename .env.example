# Copy to .env and fill in real values. Never commit the real .env —
# it's gitignored on purpose. The live server's .env is also captured
# in the daily automated backup (see /home6/smartfri/backups/nowhitewalls
# on the server), so if this file is ever lost, restore the most recent
# env-<timestamp> backup rather than regenerating values from scratch —
# regenerating AUTH_SECRET or the admin password hash will invalidate
# existing sessions and the admin login.

# MySQL connection string: mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Admin login (see src/lib/auth.ts for how these are used). Multiple admin
# accounts are supported, all with identical access: ADMIN_* is the first
# account, ADMIN2_*/ADMIN3_*/ADMIN4_* are additional ones (same three vars
# each, just with a numbered prefix). Leave a numbered set entirely blank
# to not have that extra account.
ADMIN_USERNAME=
# Random hex salt used with ADMIN_PASSWORD_HASH (crypto.scryptSync)
ADMIN_PASSWORD_SALT=
# scrypt(password, salt) as a hex string — never the plaintext password
ADMIN_PASSWORD_HASH=

# ADMIN2_USERNAME=
# ADMIN2_PASSWORD_SALT=
# ADMIN2_PASSWORD_HASH=

# Random secret used to sign the admin session cookie (openssl rand -base64 32)
AUTH_SECRET=
